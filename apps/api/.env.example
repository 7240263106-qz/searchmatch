# 环境变量模板：不要提交真实密钥或生产连接串
# 当前 API 通过进程环境变量读取配置；请在 shell、systemd 或容器配置中注入。
# 仅在本地执行 Prisma CLI 时，可在 apps/api 下使用同名 .env（该文件已被忽略）。

APP_ENV=dev
# Windows 建议使用绝对路径，并先创建空文件；示例：
# DATABASE_URL=file:C:/path/to/competition-sj/apps/api/prisma/dev.db
DATABASE_URL=file:/absolute/path/to/competition-sj/apps/api/prisma/dev.db
SERVER_LISTEN_HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PARSER_URL=http://127.0.0.1:8000
PARSER_TIMEOUT_MS=15000

# 模型地址/模型名可由配置中心维护；API Key 通过系统设置页面录入，
# 不会写入环境变量、配置文件或数据库明文字段。
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_DAILY_LIMIT=500

# 可选：base64 编码的 32 字节密钥。未设置时本地会生成 .credentials/vault.key。
# CREDENTIAL_VAULT_KEY=

# 仅开发环境使用的身份模拟；生产环境必须关闭。
DEV_IDENTITY_ENABLED=true
DEV_IDENTITY_ROLE=admin
AUTH_TEAM_ID=team-demo
