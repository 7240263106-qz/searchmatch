      "approvedBy": "deployment"
    },
    {
      "file": "apps/web/src/lib/api.ts",
      "variable": "BASE_URL",
      "purpose": "Vite内置部署路径定位同源引导接口，API运行地址仍以服务端引导为准",
      "approvedBy": "deployment"
    },
    {
      "file": "apps/api/src/config/config-resolver.service.ts",
      "variable": "*",
      "purpose": "首启初始化默认值读取：按配置项定义的 envVar 生成 version=1",
      "approvedBy": "team-admin"
    },
    {
      "file": "apps/api/src/config/config-resolver.service.ts",
      "variable": "APP_ENV",
      "purpose": "运行环境标识首启默认值",
      "approvedBy": "team-admin"
    },
    {
      "file": "apps/api/src/config/config-resolver.service.ts",
      "variable": "NODE_ENV",
