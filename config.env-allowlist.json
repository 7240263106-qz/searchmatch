    {
      "file": "apps/api/src/config/database-bootstrap.ts",
      "variable": "DATABASE_URL",
      "purpose": "引导连接与首启默认值",
      "approvedBy": "team-admin"
    },
    {
      "file": "apps/api/src/config/database-bootstrap.ts",
      "variable": "DB_PASSWORD",
      "purpose": "紧急回退显式启动参数",
      "approvedBy": "team-admin"
    },
    {
      "file": "apps/api/src/config/connection-runtime.service.ts",
